{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "**/node_modules/**",
      "README.md",
      "README.txt",
      "deploy.sh"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/404", "destination": "/404.html" }
    ]
  }
}
