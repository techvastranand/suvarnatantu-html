{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "**/node_modules/**",
      "README.md",
      "README.txt",
      "deploy.sh",
      "package.json",
      "package-lock.json",
      "playwright.config.mjs",
      "scripts/**",
      "tests/**",
      "test-results/**",
      "playwright-report/**",
      "*.md",
      "seo-master-map.csv"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
          { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api-engage.vastranand.com; frame-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self' blob:" }
        ]
      },
      {
        "source": "!/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/blog/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(webp|jpg|jpeg|png|svg|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
        ]
      }
    ],
    "redirects": [
      {"regex": "^/(?:blog/)?how-to-send-yarn-sample-reference(?:/|/index\\.html)?$", "destination": "/blog/", "type": 301},
      {"regex": "^/(?:blog/)?b2b-yarn-specification-checklist(?:/|/index\\.html)?$", "destination": "/blog/", "type": 301},
      {"regex": "^/(?:blog/)?metallic-yarn-trends-textile-manufacturing(?:/|/index\\.html)?$", "destination": "/blog/", "type": 301},
      {"regex": "^/(?:blog/)?how-to-choose-metallic-yarn-supplier-india(?:/|/index\\.html)?$", "destination": "/blog/", "type": 301},
      {"regex": "^/(?:blog/)?how-metallic-yarn-is-made(?:/|/index\\.html)?$", "destination": "/blog/", "type": 301},
      {"regex": "^/(?:blog/)?best-zari-yarn-for-saree-weaving(?:/|/index\\.html)?$", "destination": "/blog/", "type": 301},
      {"regex": "^/(?:blog/)?what-is-metallic-yarn(?:/|/index\\.html)?$", "destination": "/blog/", "type": 301},
      {"regex": "^/(?:blog/)?what-is-tpm-in-zari-yarn(?:/|/index\\.html)?$", "destination": "/blog/", "type": 301},
      {"regex": "^/(?:blog/)?what-is-denier-in-metallic-yarn(?:/|/index\\.html)?$", "destination": "/blog/", "type": 301},
      { "regex": "^/products\\.html/?$", "destination": "/products/", "type": 301 },
      { "regex": "^/blog\\.html/?$", "destination": "/blog/", "type": 301 },
      { "regex": "^/exports/metallic-yarn-exporter-india(?:\\.html)?/?$", "destination": "/export/metallic-yarn-exporter-india/", "type": 301 },
      { "regex": "^/exports/zari-yarn-exporter-india(?:\\.html)?/?$", "destination": "/export/zari-yarn-exporter-india/", "type": 301 },
      { "regex": "^/exports/international-bulk-orders(?:\\.html)?/?$", "destination": "/export/international-bulk-orders/", "type": 301 },
      { "regex": "^/exports/export-packaging(?:\\.html)?/?$", "destination": "/export/export-packaging/", "type": 301 },
      { "regex": "^/exports/?$", "destination": "/export/", "type": 301 },
      { "regex": "^/request-samples(?:\\.html)?/?$", "destination": "/samples/", "type": 301 },
      { "regex": "^/applications/saree-weaving(?:\\.html)?/?$", "destination": "/applications/saree/", "type": 301 },
      { "regex": "^/products/metallic-zari/gold-metallic-zari(?:\\.html)?/?$", "destination": "/colours/gold/", "type": 301 },
      { "regex": "^/products/metallic-zari/silver-metallic-zari(?:\\.html)?/?$", "destination": "/colours/silver/", "type": 301 },
      { "regex": "^/products/metallic-zari/copper-metallic-zari(?:\\.html)?/?$", "destination": "/colours/copper/", "type": 301 },
      { "regex": "^/products/metallic-zari/rose-gold-metallic-zari(?:\\.html)?/?$", "destination": "/colours/rose-gold/", "type": 301 },
      { "regex": "^/products/metallic-zari/coloured-metallic-zari(?:\\.html)?/?$", "destination": "/zari-yarn/coloured-zari/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/404", "destination": "/404.html" }
    ]
  }
}
